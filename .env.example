# SQLite file for local development. Use a postgres:// URL in production
# (and switch the provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies and video tokens.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Where uploaded videos are stored (outside /public so they are never served directly).
VIDEO_STORAGE_DIR="./storage/videos"

# Where uploaded documents are stored (course outlines, materials, assignment submissions).
DOCUMENT_STORAGE_DIR="./storage/documents"

# Maximum video upload size in megabytes.
MAX_VIDEO_MB="1024"

# Initial super admin created by `npm run db:seed`.
SEED_SUPERADMIN_EMAIL="superadmin@nowlms.local"
SEED_SUPERADMIN_PASSWORD="ChangeMe123!"
